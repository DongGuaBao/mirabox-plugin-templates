{
    "include": ["src/node/**/*.ts"],
    "compilerOptions": {
        "target": "es2020",
        "module": "esnext",
        "lib": ["es2020"],
        "sourceMap": true,
        "inlineSources": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "strict": false,
        "resolveJsonModule": true,
        "allowSyntheticDefaultImports": true,
        "types": ["mirabox-plugin-sdk/types", "@types/node"],
        "rootDir": "./src/",
        "outDir": "./build/tsc_build"
    }
}
